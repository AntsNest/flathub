  "sdk": "org.freedesktop.Sdk",
  "command": "nodemaster",
  "modules": [
    {
      "name": "nodemaster",
      "buildsystem": "simple",
      "build-commands": [
        "install -Dm755 hello.sh /app/bin/hello"
      ],
      "sources": [
        {
